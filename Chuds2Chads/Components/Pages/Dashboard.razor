    private string FormatChips(int chips)
    {
        if (chips >= 1000000) return $"${chips / 1000000.0:F1}M";
        if (chips >= 1000) return $"${chips / 1000.0:F1}K";
        return $"${chips}";
    }

    private string GetMedal(int position) => position switch
    {
        0 => "🥇",
        1 => "🥈",
        2 => "🥉",
        _ => ""
    };

    private void ToggleUserMenu() => showUserMenu = !showUserMenu;

