    // User data (TODO: Replace with actual data from your auth/database service)
    private string username = "Player123";
    private int userChips = 15750;
    private int dailyEarnings = 2340;
    private string userRank = "High Roller";
    private int rankProgress = 68;
    private int winRate = 62;
    private int totalWins = 47;
    private int totalGames = 76;
    private int winStreak = 5;
    private int bestStreak = 12;

    // Game stats
    private int blackjackOnline = 247;
    private int blackjackTables = 8;
    private int pokerOnline = 183;
    private int pokerTables = 6;

    // UI state
