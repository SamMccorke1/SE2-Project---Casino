@page "/blackjack-game/{LobbyName}"
@inject NavigationManager Navigation
@using Chuds2Chads.Games.Blackjack

<button @onclick="ReturnHome" style="position:absolute; top:10px; left:10px;">Home</button>

<h3>Blackjack - Lobby: @LobbyName</h3>

<div class="table">
    <div class="dealer-area">
        @foreach(var card in Game.Dealer.Hand.Select((value,index) => new {value,index}))
        {
            <img src="@(index==1 && !Game.DealerRevealed ? Card.CardBackPath : card.value.ImagePath)" class="card @(index==1 && !Game.DealerRevealed ? "" : "deal")" />
        }
    </div>

    <div class="player-area">
        @foreach(var card in Game.CurrentPlayer.Hand)
        {
            <img src="@card.ImagePath" class="card deal" />
        }
    </div>

    <div class="game-buttons">
        @if(Game.Phase == GamePhase.PlayerTurn)
        {
            <button class="hit-btn" @onclick="Hit">Hit</button>
            <button class="stand-btn" @onclick="Stand">Stand</button>
        }
    </div>
</div>

@code {
    [Parameter] public string BlackjackLobby { get; set; }

    private BlackjackGame Game;

    protected override void OnInitialized()
    {
        Game = new BlackjackGame(new List<string> { "Player1" }); // only current user for now
    }

    private void Hit()
    {
        Game.PlayerHit();
    }

    private void Stand()
    {
        Game.PlayerStand();
    }

    private void ReturnHome()
    {
        Navigation.NavigateTo("/");
    }
}
