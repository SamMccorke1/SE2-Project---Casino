@page "/profile"
@using Microsoft.AspNetCore.Components.Routing
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Profile - Chuds to Chads Casino</PageTitle>

<div class="profile-container">
    <div class="profile-header">
        <NavLink href="/" class="back-link">← Back to Casino</NavLink>
        <h1>Player Profile</h1>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-loading">Loading profile...</div>
    }
    else if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-error">@message</div>
    }
    else if (user != null)
    {
        <div class="profile-card">
            <div class="profile-avatar">
                <div class="avatar-placeholder">👤</div>
            </div>
            
            <div class="profile-info">
                <h2>@user.UserName</h2>
                <p class="email">@user.Email</p>
                <p class="member-since">Member since @user.CreatedDate.ToString("MMMM d, yyyy")</p>
                <div class="profile-tags">
                    <span class="tag tag-tier">Tier: Bronze</span>
                    <span class="tag tag-status">Status: Active</span>
                </div>
            </div>

            <div class="profile-stats">
                <div class="stat">
                    <span class="stat-label">Balance</span>
                    <span class="stat-value">$1,000</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Games Played</span>
                    <span class="stat-value">0</span>
                </div>
                <div class="stat">
                    <span class="stat-label">Wins</span>
                    <span class="stat-value">0</span>
                </div>
            </div>

            <div class="profile-grid">
                <div class="profile-panel">
                    <h3 class="panel-title">Casino Snapshot</h3>
                    <div class="panel-row">
                        <span class="panel-label">Win Rate</span>
                        <span class="panel-value">0%</span>
                    </div>
                    <div class="panel-row">
                        <span class="panel-label">Favorite Game</span>
                        <span class="panel-value">Blackjack</span>
                    </div>
                    <div class="panel-row">
                        <span class="panel-label">Longest Streak</span>
                        <span class="panel-value">0</span>
                    </div>
                    <div class="panel-row">
                        <span class="panel-label">Last Seen</span>
                        <span class="panel-value">Just now</span>
                    </div>
                </div>

                <div class="profile-panel">
                    <h3 class="panel-title">Recent Activity</h3>
                    <ul class="activity-list">
                        <li>Joined the casino lobby</li>
                        <li>Viewed Blackjack tables</li>
                        <li>Updated profile settings</li>
                    </ul>
                </div>
            </div>

            <div class="profile-actions">
                <button class="btn-customize" @onclick="GoToCustomization">Customize Character</button>
                <button class="btn-logout" @onclick="HandleLogout">Logout</button>
            </div>
        </div>
    }
</div>

<style>
.profile-container {
    max-width: 600px;
    margin: 40px auto;
    padding: 20px;
}

.profile-header {
    margin-bottom: 30px;
}

.back-link {
    color: #4ade80;
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 10px;
    display: inline-block;
}

.back-link:hover {
    text-decoration: underline;
}

.profile-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border: 2px solid #4ade80;
    border-radius: 12px;
    padding: 40px;
    text-align: center;
}

.profile-avatar {
    margin-bottom: 20px;
}

.avatar-placeholder {
    width: 100px;
    height: 100px;
    background: rgba(74, 222, 128, 0.1);
    border: 2px solid #4ade80;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 50px;
    margin: 0 auto;
}

.profile-info h2 {
    margin: 20px 0 10px 0;
    color: #4ade80;
    font-size: 28px;
}

.email {
    color: #9ca3af;
    font-size: 14px;
    margin: 5px 0;
}

.member-since {
    color: #6b7280;
    font-size: 12px;
    margin-top: 10px;
}

.profile-tags {
    margin-top: 12px;
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
}

.tag {
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(74, 222, 128, 0.35);
    color: #4ade80;
}

.tag-status {
    border-color: rgba(96, 165, 250, 0.4);
    color: #60a5fa;
}

.profile-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin: 30px 0;
    padding: 20px 0;
    border-top: 1px solid rgba(74, 222, 128, 0.2);
    border-bottom: 1px solid rgba(74, 222, 128, 0.2);
}

.stat {
    text-align: center;
}

.stat-label {
    display: block;
    color: #9ca3af;
    font-size: 12px;
    margin-bottom: 5px;
}

.stat-value {
    display: block;
    color: #4ade80;
    font-size: 24px;
    font-weight: bold;
}

.profile-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 30px;
}

.profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.profile-panel {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 10px;
    padding: 18px;
    text-align: left;
}

.panel-title {
    color: #e2e8f0;
    font-size: 16px;
    margin-bottom: 12px;
}

.panel-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 13px;
}

.panel-label {
    color: #9ca3af;
}

.panel-value {
    color: #4ade80;
    font-weight: 600;
}

.activity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #cbd5f5;
    font-size: 13px;
}

.btn-customize {
    background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
    color: black;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s;
}

.btn-customize:hover {
    transform: translateY(-2px);
}

.btn-logout {
    background: transparent;
    color: #ef4444;
    border: 2px solid #ef4444;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-logout:hover {
    background: rgba(239, 68, 68, 0.1);
}

.alert {
    padding: 15px;
    border-radius: 6px;
    margin-top: 20px;
    text-align: center;
}

.alert-info {
    background: rgba(59, 130, 246, 0.1);
    color: #60a5fa;
    border: 1px solid #3b82f6;
}

.alert-error {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid #ef4444;
}

.alert-loading {
    background: rgba(16, 185, 129, 0.08);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.4);
}

</style>

<style>
@@media (max-width: 700px) {
    .profile-card {
        padding: 28px 20px;
    }

    .profile-stats {
        grid-template-columns: 1fr;
    }

    .profile-grid {
        grid-template-columns: 1fr;
    }

    .profile-actions {
        flex-direction: column;
    }
}
</style>

@code {
    private UserProfile? user;
    private string message = "";
    private bool isLoading = true;

    private sealed class ApiResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Text { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            var result = await JS.InvokeAsync<ApiResult>("auth.currentUser");
            if (result.Ok)
            {
                user = System.Text.Json.JsonSerializer.Deserialize<UserProfile>(result.Text ?? "",
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (user == null)
                {
                    message = "Profile data is unavailable.";
                }
            }
            else
            {
                message = !string.IsNullOrEmpty(result.Text)
                    ? $"Failed to load profile: {result.Text}"
                    : $"Failed to load profile with status {result.Status}.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoToCustomization()
    {
        Navigation.NavigateTo("/customize");
    }

    private async Task HandleLogout()
    {
        try
        {
            var result = await JS.InvokeAsync<ApiResult>("auth.logout");
            if (result.Ok)
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                message = !string.IsNullOrEmpty(result.Text)
                    ? $"Logout failed: {result.Text}"
                    : $"Logout failed with status {result.Status}.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    public class UserProfile
    {
        public string Id { get; set; } = "";
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public DateTime CreatedDate { get; set; } = DateTime.UtcNow;
    }
}
