@page "/profile"
@using Microsoft.AspNetCore.Components.Routing
@using Chuds2Chads.Data.Entities
@using Chuds2Chads.Services
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AvatarService AvatarService
@attribute [Authorize]

<PageTitle>Profile - Chuds to Chads Casino</PageTitle>

<div class="profile-page">
    <div class="bg-grid"></div>
    <div class="bg-glow bg-glow-1"></div>
    <div class="bg-glow bg-glow-2"></div>

    <div class="profile-container">
        <div class="profile-header">
            <NavLink href="/Dashboard" class="back-link">← Back to Casino</NavLink>
            <h1>Player Profile</h1>
        </div>

        @if (isLoading)
        {
            <div class="alert alert-loading">Loading profile...</div>
        }
        else if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-error">@message</div>
        }
        else if (user != null)
        {
            <div class="profile-card">
                <div class="profile-avatar">
                    <div class="avatar-placeholder">@GetAvatarGlyph()</div>
                    <div class="avatar-loadout">
                        @foreach (var slot in OrderedSlots)
                        {
                            <div class="avatar-row">
                                <span class="avatar-slot">@slot</span>
                                <span class="avatar-item">@GetEquippedName(slot)</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="profile-info">
                    <h2>@user.UserName</h2>
                    <p class="email">@user.Email</p>
                    <p class="member-since">Member since @user.CreatedDate.ToString("MMMM d, yyyy")</p>
                    <div class="profile-tags">
                        <span class="tag tag-tier">Tier: Bronze</span>
                        <span class="tag tag-status">Status: Active</span>
                    </div>
                </div>

                <div class="profile-stats">
                    <div class="stat stat-chips">
                        <span class="stat-label">Balance</span>
                        <span class="stat-value">$1,000</span>
                    </div>
                    <div class="stat stat-games">
                        <span class="stat-label">Games Played</span>
                        <span class="stat-value">0</span>
                    </div>
                    <div class="stat stat-wins">
                        <span class="stat-label">Wins</span>
                        <span class="stat-value">0</span>
                    </div>
                </div>

                <div class="profile-grid">
                    <div class="profile-panel">
                        <h3 class="panel-title">Casino Snapshot</h3>
                        <div class="panel-row">
                            <span class="panel-label">Win Rate</span>
                            <span class="panel-value">0%</span>
                        </div>
                        <div class="panel-row">
                            <span class="panel-label">Favorite Game</span>
                            <span class="panel-value">Blackjack</span>
                        </div>
                        <div class="panel-row">
                            <span class="panel-label">Longest Streak</span>
                            <span class="panel-value">0</span>
                        </div>
                        <div class="panel-row">
                            <span class="panel-label">Last Seen</span>
                            <span class="panel-value">Just now</span>
                        </div>
                    </div>

                    <div class="profile-panel">
                        <h3 class="panel-title">Recent Activity</h3>
                        <ul class="activity-list">
                            <li>Joined the casino lobby</li>
                            <li>Viewed Blackjack tables</li>
                            <li>Updated profile settings</li>
                        </ul>
                    </div>
                </div>

                <div class="profile-actions">
                    <button class="btn-customize" @onclick="GoToCustomization">Customize Character</button>
                    <button class="btn-logout" @onclick="HandleLogout">Logout</button>
                </div>
            </div>
        }
    </div>
</div>
<style>
/* ===== Page Shell ===== */
.profile-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0a0118 0%, #1a0933 100%);
    color: white;
    font-family: 'Outfit', sans-serif;
    position: relative;
    overflow-x: hidden;
}

/* ===== Background Effects ===== */
.bg-grid {
    position: fixed;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 255, 65, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 255, 65, 0.02) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridPan 30s linear infinite;
    pointer-events: none;
}

@@keyframes gridPan {
    0%   { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
}

.bg-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.15;
    pointer-events: none;
    animation: glowFloat 20s ease-in-out infinite;
}

.bg-glow-1 {
    background: radial-gradient(circle, #00ff41, transparent);
    top: -10%;
    left: -10%;
}

.bg-glow-2 {
    background: radial-gradient(circle, #ffd700, transparent);
    bottom: -10%;
    right: -10%;
    animation-delay: 10s;
}

@@keyframes glowFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%       { transform: translate(30px, -30px) scale(1.1); }
}

/* ===== Layout ===== */
.profile-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 3%;
    position: relative;
    animation: fadeInUp 0.6s ease-out;
}

@@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ===== Page Header ===== */
.profile-header {
    margin-bottom: 2.5rem;
}

.profile-header h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 2px;
    margin: 0.5rem 0 0;
    background: linear-gradient(135deg, #00ff41, #ffd700);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.back-link {
    color: #00ff41;
    text-decoration: none;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    opacity: 0.8;
    transition: opacity 0.2s, transform 0.2s;
}

.back-link:hover {
    opacity: 1;
    transform: translateX(-4px);
}

/* ===== Profile Card ===== */
.profile-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(0, 255, 65, 0.2);
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
}

/* ===== Avatar ===== */
.profile-avatar {
    margin-bottom: 1.5rem;
}

.avatar-placeholder {
    width: 96px;
    height: 96px;
    background: linear-gradient(135deg, #00ff41, #ffd700);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Russo One', sans-serif;
    font-size: 2.5rem;
    color: #0a0118;
    margin: 0 auto;
    box-shadow: 0 0 30px rgba(0, 255, 65, 0.3);
}

.avatar-loadout {
    margin-top: 12px;
    text-align: left;
    max-width: 260px;
    margin-left: auto;
    margin-right: auto;
}

.avatar-row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
    color: #cbd5e1;
    margin-bottom: 4px;
}

.avatar-slot {
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.avatar-item {
    color: #4ade80;
    font-weight: 600;
    text-align: right;
}

/* ===== User Info ===== */
.profile-info h2 {
    font-family: 'Russo One', sans-serif;
    font-size: 2rem;
    color: #ffd700;
    margin: 0 0 0.4rem;
}

.email {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    margin: 0.3rem 0;
}

.member-since {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.8rem;
    margin-top: 0.4rem;
}

.profile-tags {
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
}

.tag {
    font-size: 0.75rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 255, 65, 0.35);
    color: #00ff41;
}

.tag-status {
    border-color: rgba(0, 212, 255, 0.4);
    color: #00d4ff;
}

/* ===== Stats Row ===== */
.profile-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(0, 255, 65, 0.15);
    border-bottom: 1px solid rgba(0, 255, 65, 0.15);
}

.stat {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.2rem 1rem;
    transition: all 0.3s ease;
}

.stat:hover {
    transform: translateY(-3px);
    border-color: var(--stat-accent, #00ff41);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
}

.stat-chips  { --stat-accent: #00ff41; }
.stat-games  { --stat-accent: #ffd700; }
.stat-wins   { --stat-accent: #00d4ff; }

.stat-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.5rem;
}

.stat-value {
    display: block;
    font-family: 'Russo One', sans-serif;
    font-size: 1.8rem;
    color: var(--stat-accent, #00ff41);
    line-height: 1;
}

/* ===== Info Panels ===== */
.profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.profile-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.5rem;
    text-align: left;
    transition: border-color 0.3s ease;
}

.profile-panel:hover {
    border-color: rgba(0, 255, 65, 0.25);
}

.panel-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1rem;
}

.panel-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.7rem;
    font-size: 0.85rem;
}

.panel-label {
    color: rgba(255, 255, 255, 0.5);
}

.panel-value {
    font-family: 'Russo One', sans-serif;
    color: #00ff41;
    font-size: 0.9rem;
}

.activity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
}

.activity-list li {
    padding: 0.5rem 0.7rem;
    background: rgba(0, 255, 65, 0.04);
    border-radius: 6px;
    border-left: 2px solid rgba(0, 255, 65, 0.3);
}

/* ===== Action Buttons ===== */
.profile-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
}

.btn-customize {
    padding: 0.8rem 2rem;
    background: linear-gradient(135deg, #00ff41, #ffd700);
    border: none;
    border-radius: 10px;
    color: #0a0118;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-customize:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 255, 65, 0.4);
}

.btn-logout {
    padding: 0.8rem 2rem;
    background: transparent;
    color: #ff2e63;
    border: 1px solid rgba(255, 46, 99, 0.5);
    border-radius: 10px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-logout:hover {
    background: rgba(255, 46, 99, 0.1);
    border-color: #ff2e63;
    transform: translateY(-2px);
}

/* ===== Alerts ===== */
.alert {
    padding: 1rem 1.5rem;
    border-radius: 10px;
    text-align: center;
}

.alert-error {
    background: rgba(255, 46, 99, 0.1);
    color: #ff2e63;
    border: 1px solid rgba(255, 46, 99, 0.4);
}

.alert-loading {
    background: rgba(0, 255, 65, 0.06);
    color: #00ff41;
    border: 1px solid rgba(0, 255, 65, 0.3);
}

/* ===== Responsive ===== */
@@media (max-width: 700px) {
    .profile-card {
        padding: 2rem 1.5rem;
    }

    .profile-stats {
        grid-template-columns: 1fr;
    }

    .profile-grid {
        grid-template-columns: 1fr;
    }

    .profile-actions {
        flex-direction: column;
    }
}
</style>

@code {
    private static readonly AvatarSlot[] OrderedSlots =
    [
        AvatarSlot.Head,
        AvatarSlot.Face,
        AvatarSlot.Body,
        AvatarSlot.Torso,
        AvatarSlot.Legs,
        AvatarSlot.Shoe,
        AvatarSlot.Pet
    ];

    private UserProfile? user;
    private AvatarCustomizationData? avatarData;
    private string message = "";
    private bool isLoading = true;

    private sealed class ApiResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Text { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            var result = await JS.InvokeAsync<ApiResult>("auth.currentUser");
            if (result.Ok)
            {
                user = System.Text.Json.JsonSerializer.Deserialize<UserProfile>(result.Text ?? "",
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (user == null)
                {
                    message = "Profile data is unavailable.";
                }
                else if (Guid.TryParse(user.Id, out var parsedUserId))
                {
                    avatarData = await AvatarService.GetCustomizationDataAsync(parsedUserId);
                }
            }
            else
            {
                message = !string.IsNullOrEmpty(result.Text)
                    ? $"Failed to load profile: {result.Text}"
                    : $"Failed to load profile with status {result.Status}.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetEquippedName(AvatarSlot slot)
    {
        if (avatarData is null)
        {
            return "None";
        }

        if (!avatarData.EquippedObjectIds.TryGetValue(slot, out var equippedObjectId) || equippedObjectId is null)
        {
            return "None";
        }

        var item = avatarData.OwnedCosmetics.FirstOrDefault(i => i.ObjectId == equippedObjectId.Value);
        return item?.Name ?? "None";
    }

    private string GetAvatarGlyph()
    {
        if (avatarData is null)
        {
            return "👤";
        }

        var hasPet = avatarData.EquippedObjectIds.TryGetValue(AvatarSlot.Pet, out var pet) && pet is not null;
        return hasPet ? "🧑" : "👤";
    }

    private void GoToCustomization()
    {
        Navigation.NavigateTo("/customize");
    }

    private async Task HandleLogout()
    {
        try
        {
            var result = await JS.InvokeAsync<ApiResult>("auth.logout");
            if (result.Ok)
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                message = !string.IsNullOrEmpty(result.Text)
                    ? $"Logout failed: {result.Text}"
                    : $"Logout failed with status {result.Status}.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    public class UserProfile
    {
        public string Id { get; set; } = "";
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public DateTime CreatedDate { get; set; } = DateTime.UtcNow;
    }
}