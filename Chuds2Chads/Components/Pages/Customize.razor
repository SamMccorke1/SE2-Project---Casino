@page "/customize"
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Customize Character - Chuds to Chads Casino</PageTitle>

<div class="customize-container">
    <div class="customize-header">
        <NavLink href="/profile" class="back-link">← Back to Profile</NavLink>
        <h1>Character Customization</h1>
    </div>

    <div class="customize-card">
        <div class="coming-soon">
            <p>🎨 Character customization features coming soon!</p>
            <p>Customize your avatar, cosmetics, and personal settings to make your casino experience truly yours.</p>
        </div>
    </div>
</div>

<style>
.customize-container {
    max-width: 600px;
    margin: 40px auto;
    padding: 20px;
}

.customize-header {
    margin-bottom: 30px;
}

.back-link {
    color: #4ade80;
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 10px;
    display: inline-block;
}

.back-link:hover {
    text-decoration: underline;
}

.customize-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border: 2px solid #4ade80;
    border-radius: 12px;
    padding: 40px;
    text-align: center;
}

.coming-soon {
    color: #9ca3af;
}

.coming-soon p {
    margin: 15px 0;
    line-height: 1.6;
}

.coming-soon p:first-child {
    color: #4ade80;
    font-size: 32px;
    margin-bottom: 20px;
}

.coming-soon p:last-child {
    font-size: 14px;
}
</style>
