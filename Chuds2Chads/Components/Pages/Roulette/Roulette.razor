@page "/roulette/roulette"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject Chuds2Chads.Services.WalletService WalletService
@inject Chuds2Chads.Services.RouletteService RouletteService

<PageTitle>Roulette – C2C Casino</PageTitle>

<div class="game-page roulette-page">
    <div class="ambient-glow glow-green"></div>
    <div class="ambient-glow glow-red"></div>

    <div class="game-header">
        <a href="/" class="back-link">← Back to Casino</a>
        <h1 class="game-title-header">🎡 <span class="highlight">Roulette</span></h1>
        @if (userId != Guid.Empty)
        {
            <div class="balance-pill">💰 @balance chips</div>
        }
        else
        {
            <div class="balance-pill guest">👤 Guest Mode</div>
        }
    </div>

    <div class="game-layout">
        <div class="wheel-panel">
            <div class="wheel-wrapper">
                <div class="wheel-outer-ring"></div>
                <div class="wheel @(isSpinning ? "wheel-spinning" : "")"
                     style="@(hasResult ? $"transform: rotate({spinDegrees}deg);" : "")">
                    @for (int i = 0; i < 37; i++)
                    {
                        int num = i;
                        <div class="wheel-segment @GetSegmentColor(num)"
                             style="@($"transform: rotate({i * (360.0/37)}deg);")">
                            <span class="segment-number">@num</span>
                        </div>
                    }
                </div>
                <div class="wheel-ball-track">
                    <div class="wheel-ball @(isSpinning ? "ball-spinning" : "") @(hasResult ? "ball-landed" : "")"></div>
                </div>
                <div class="wheel-center"><div class="wheel-center-dot"></div></div>
            </div>

            @if (hasResult)
            {
                <div class="result-display @(lastWon ? "result-win" : "result-neutral") animate-pop">
                    <span class="result-number">@resultNumber</span> — @GetNumberColor(resultNumber)
                    <br/><span class="result-message">@lastResult</span>
                </div>
            }
        </div>

        <div class="bet-panel">
            <div class="bet-section">
                <h3 class="bet-heading">Place Your Bet</h3>
                <div class="chip-selector">
                    @foreach (var chip in chipValues)
                    {
                        <button class="chip-btn @(selectedChip == chip ? "chip-selected" : "") chip-@GetChipColor(chip)"
                                @onclick="() => selectedChip = chip" disabled="@isSpinning">@chip</button>
                    }
                </div>
                <div class="bet-types">
                    <div class="bet-type-group">
                        <span class="bet-type-label">Color</span>
                        <div class="bet-type-buttons">
                            <button class="bet-btn bet-red @(betType == "red" ? "bet-active" : "")"
                                    @onclick='() => SetBet("red")' disabled="@isSpinning">🔴 Red <span class="odds-tag">2x</span></button>
                            <button class="bet-btn bet-black @(betType == "black" ? "bet-active" : "")"
                                    @onclick='() => SetBet("black")' disabled="@isSpinning">⚫ Black <span class="odds-tag">2x</span></button>
                            <button class="bet-btn bet-green @(betType == "green" ? "bet-active" : "")"
                                    @onclick='() => SetBet("green")' disabled="@isSpinning">🟢 Zero <span class="odds-tag">35x</span></button>
                        </div>
                    </div>
                    <div class="bet-type-group">
                        <span class="bet-type-label">Parity</span>
                        <div class="bet-type-buttons">
                            <button class="bet-btn @(betType == "even" ? "bet-active" : "")"
                                    @onclick='() => SetBet("even")' disabled="@isSpinning">Even <span class="odds-tag">2x</span></button>
                            <button class="bet-btn @(betType == "odd" ? "bet-active" : "")"
                                    @onclick='() => SetBet("odd")' disabled="@isSpinning">Odd <span class="odds-tag">2x</span></button>
                        </div>
                    </div>
                    <div class="bet-type-group">
                        <span class="bet-type-label">Range</span>
                        <div class="bet-type-buttons">
                            <button class="bet-btn @(betType == "low" ? "bet-active" : "")"
                                    @onclick='() => SetBet("low")' disabled="@isSpinning">1-18 <span class="odds-tag">2x</span></button>
                            <button class="bet-btn @(betType == "high" ? "bet-active" : "")"
                                    @onclick='() => SetBet("high")' disabled="@isSpinning">19-36 <span class="odds-tag">2x</span></button>
                        </div>
                    </div>
                </div>
                <div class="bet-summary">Bet: <strong>@selectedChip</strong> on <strong>@(betType ?? "—")</strong></div>
                <button class="spin-btn @(isSpinning ? "spin-btn-active" : "")"
                        @onclick="SpinWheel" disabled="@(isSpinning || betType == null)">
                    @if (isSpinning) { <span class="spinner-ring"></span><span>Spinning…</span> }
                    else { <span>🎡 Spin!</span> }
                </button>
                @if (!string.IsNullOrEmpty(statusMsg))
                {
                    <div class="status-msg @(lastWon ? "msg-win" : "msg-neutral")">@statusMsg</div>
                }
            </div>
            @if (history.Count > 0)
            {
                <div class="history-panel">
                    <h4 class="history-heading">Recent Spins</h4>
                    <div class="history-list">
                        @foreach (var h in history.TakeLast(10).Reverse())
                        {
                            <span class="history-pip history-@h.Color">@h.Number</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private Guid userId = Guid.Empty;
    private long balance = 0;
    private readonly int[] chipValues = [10, 25, 50, 100, 250];
    private int selectedChip = 25;
    private string? betType;
    private bool isSpinning = false;
    private bool hasResult  = false;
    private double spinDegrees = 0;
    private int resultNumber = 0;
    private string lastResult = "";
    private bool lastWon = false;
    private string statusMsg = "";
    private readonly List<(int Number, string Color)> history = new();
    private static readonly int[] RedNumbers = [1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user  = state.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (Guid.TryParse(idClaim, out var parsed))
            {
                userId  = parsed;
                balance = (await WalletService.GetBalanceAsync(userId)) ?? 0;
            }
        }
    }

    private void SetBet(string type) => betType = type;
    private string GetSegmentColor(int n) => n == 0 ? "seg-green" : RedNumbers.Contains(n) ? "seg-red" : "seg-black";
    private string GetNumberColor(int n)  => n == 0 ? "Zero (Green)" : RedNumbers.Contains(n) ? "Red" : "Black";
    private string GetChipColor(int v)    => v switch { 10 => "blue", 25 => "red", 50 => "purple", 100 => "gold", _ => "black" };

    private async Task SpinWheel()
    {
        if (betType == null || isSpinning) return;
        if (userId != Guid.Empty)
        {
            bool placed = await WalletService.TryPlaceBetAsync(userId, selectedChip, $"roulette-bet-{DateTime.UtcNow:yyyyMMddHHmmss}");
            if (!placed) { statusMsg = "Insufficient chips."; return; }
            balance -= selectedChip;
        }
        isSpinning = true; hasResult = false; statusMsg = "";
        StateHasChanged();
        await Task.Delay(100);
        resultNumber = Random.Shared.Next(0, 37);
        spinDegrees  = (spinDegrees % 360) + 1440 + (resultNumber * (360.0 / 37));
        StateHasChanged();
        await Task.Delay(3200);
        bool win    = EvaluateBet(resultNumber, betType!);
        long payout = win ? (long)(selectedChip * GetMultiplier(betType!)) : 0;
        if (win && userId != Guid.Empty)
        {
            await WalletService.CreditPayoutAsync(userId, payout, $"roulette-payout-{DateTime.UtcNow:yyyyMMddHHmmss}");
            balance += payout;
        }
        lastResult = win ? $"🎉 +{payout} chips!" : $"😬 Lost {selectedChip} chips.";
        lastWon = win; statusMsg = lastResult; hasResult = true; isSpinning = false;
        string color = resultNumber == 0 ? "green" : RedNumbers.Contains(resultNumber) ? "red" : "black";
        history.Add((resultNumber, color));
        StateHasChanged();
    }

    private static bool EvaluateBet(int n, string bet) => bet switch
    {
        "red"   => RedNumbers.Contains(n),
        "black" => n != 0 && !RedNumbers.Contains(n),
        "green" => n == 0,
        "even"  => n != 0 && n % 2 == 0,
        "odd"   => n % 2 == 1,
        "low"   => n is >= 1 and <= 18,
        "high"  => n is >= 19 and <= 36,
        _       => false
    };

    private static double GetMultiplier(string bet) => bet == "green" ? 35.0 : 2.0;
}
